<idea-plugin>
    <id>com.auto_switch_ime</id>
    <name>自动切换输入法</name>
    <vendor url="https://github.com/zhou96-gh/AutoSwitchIME">zhou96-gh</vendor>

    <description><![CDATA[
    根据 Vim 模式自动切换输入法中英文状态（Rime/Weasel）。
    <ul>
      <li>Normal 模式始终保持英文，其他 normal-like 模式进入时默认英文</li>
      <li>Insert 模式根据光标上下文自动选择中文、大写或英文</li>
      <li>光标颜色指示 IME 状态</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="ideavim-integration.xml">IdeaVIM</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                instance="com.auto_switch_ime.settings.AutoSwitchIMESettingsConfigurable"
                id="com.auto_switch_ime.settings.AutoSwitchIMESettingsConfigurable"
                displayName="自动切换输入法"/>
        <applicationService
                serviceImplementation="com.auto_switch_ime.settings.AutoSwitchIMESettings"/>
        <postStartupActivity implementation="com.auto_switch_ime.AutoSwitchIMEPlugin"/>
    </extensions>

</idea-plugin>
